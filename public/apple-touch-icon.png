<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180">
  <!-- Background -->
  <rect width="180" height="180" fill="#0a0a0a"/>
  
  <!-- Golden accent circle -->
  <circle cx="90" cy="90" r="80" fill="none" stroke="#d4af37" stroke-width="3" opacity="0.8"/>
  
  <!-- House shape -->
  <g transform="translate(90, 90)">
    <!-- Roof -->
    <polygon points="0,-45 -35,-10 35,-10" fill="#d4af37"/>
    
    <!-- House body -->
    <rect x="-32" y="-10" width="64" height="50" fill="#f3ede2" stroke="#d4af37" stroke-width="2"/>
    
    <!-- Door -->
    <rect x="-14" y="12" width="14" height="28" fill="#0a0a0a" stroke="#d4af37" stroke-width="2"/>
    
    <!-- Door handle -->
    <circle cx="0" cy="26" r="2.5" fill="#d4af37"/>
    
    <!-- Left window -->
    <rect x="-28" y="-2" width="12" height="12" fill="#c4a875" stroke="#d4af37" stroke-width="1.5"/>
    <line x1="-22" y1="-2" x2="-22" y2="10" stroke="#d4af37" stroke-width="1"/>
    <line x1="-28" y1="4" x2="-16" y2="4" stroke="#d4af37" stroke-width="1"/>
    
    <!-- Right window -->
    <rect x="16" y="-2" width="12" height="12" fill="#c4a875" stroke="#d4af37" stroke-width="1.5"/>
    <line x1="22" y1="-2" x2="22" y2="10" stroke="#d4af37" stroke-width="1"/>
    <line x1="16" y1="4" x2="28" y2="4" stroke="#d4af37" stroke-width="1"/>
  </g>
</svg>
